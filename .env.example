# ==============================================================================
# Observador de Concursos - Environment Configuration Template
# ==============================================================================
# To configure the backend, copy this file to `backend/.env`:
#   cp .env.example backend/.env
#
# For the mobile application, copy to `mobile/.env`:
#   cp mobile/.env.example mobile/.env
#
# NEVER commit your actual `.env` files with real keys or credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Core Configuration
# ------------------------------------------------------------------------------
APP_NAME="Observador de Concursos"
APP_ENV=development
APP_DEBUG=true
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# JWT Secret Key - REQUIRED: Change to a strong random key in production
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Database & Broker (Used outside Docker Compose; Compose overrides these)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/observador
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------------------------
# Crawler & TenderProof Verification Settings
# ------------------------------------------------------------------------------
LEGACY_CRAWLER_ENABLED=false
TENDERPROOF_INTERNAL_NOTIFICATIONS_ENABLED=false
SOLARI_API_KEY=
SOLARI_BASE_URL=https://api.getsolari.com
SOLARI_REGION=us-west
TENDERPROOF_RECORDING=true
TENDERPROOF_STEALTH=false
TENDERPROOF_PROXY=
TENDERPROOF_CAPTCHA=false

# MVP Collection Limits
TENDERPROOF_MAX_CANDIDATES=5
TENDERPROOF_MAX_NAVIGATIONS=12
TENDERPROOF_MAX_ATTEMPTS=2
TENDERPROOF_MAX_DOWNLOAD_BYTES=31457280
TENDERPROOF_MAX_DOCUMENTS=10
TENDERPROOF_TOTAL_TIMEOUT_S=300
TENDERPROOF_MAX_PAGES=60
TENDERPROOF_MAX_OBSERVED_JSON=20
TENDERPROOF_MAX_JSON_BYTES=65536
TENDERPROOF_REPLAY_DEADLINE_S=60
TENDERPROOF_REPLAY_POLL_S=5
TENDERPROOF_ALLOWLIST_EXTRA=
TENDERPROOF_ARTIFACT_DIR=

# TenderProof Publication & Continuous Processing (Keep false for local dev)
TENDERPROOF_PUBLICATION_ENABLED=false
TENDERPROOF_PUBLICATION_ALLOW_SYNTHETIC=false
TENDERPROOF_PUBLISHER_USER_IDS=
TENDERPROOF_BROWSER_LIVE_ENABLED=false
TENDERPROOF_CONTINUOUS_ENABLED=false
TENDERPROOF_CONTINUOUS_OPERATOR_USER_IDS=

# ------------------------------------------------------------------------------
# Mobile Configuration (Reference for mobile/.env)
# ------------------------------------------------------------------------------
# Physical device on LAN: http://<LAN_IP>:8000
# Android Emulator:       http://10.0.2.2:8000
# Web browser:            http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_EXPO_PROJECT_ID=
