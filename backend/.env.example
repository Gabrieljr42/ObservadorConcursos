# Copie para .env e ajuste os valores. Nunca commite o .env com segredos reais.
APP_NAME=Observador de Concursos
APP_ENV=development
APP_DEBUG=true
LEGACY_CRAWLER_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TENDERPROOF_INTERNAL_NOTIFICATIONS_ENABLED=false
# Documental: o docker-compose publica 8000:8000 e o uvicorn usa --port 8000.
API_PORT=8000
# Dentro do compose, o bloco `environment:` sobrescreve estas URLs.
# Fora do compose, aponte para Postgres/Redis acessíveis.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/observador
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# OBRIGATÓRIO trocar em qualquer ambiente real: assina os JWTs de acesso.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- TenderProof (fases 0–3): aquisição e verificação com evidências (opt-in) ---
# Chave Solari (nunca commitar o valor real). Sem ela, só o modo mock offline funciona.
SOLARI_API_KEY=
SOLARI_BASE_URL=https://api.getsolari.com
SOLARI_REGION=us-west
# Recording da sessão (evidência da navegação). Manter true.
TENDERPROOF_RECORDING=true
# Stealth/proxy/captcha desativados por padrão; só usar por necessidade observada.
TENDERPROOF_STEALTH=false
TENDERPROOF_PROXY=
TENDERPROOF_CAPTCHA=false
# Limites do MVP (candidatos tem teto fixo de 5).
TENDERPROOF_MAX_CANDIDATES=5
TENDERPROOF_MAX_NAVIGATIONS=12
TENDERPROOF_MAX_ATTEMPTS=2
TENDERPROOF_MAX_DOWNLOAD_BYTES=31457280
TENDERPROOF_MAX_DOCUMENTS=10
TENDERPROOF_TOTAL_TIMEOUT_S=300
TENDERPROOF_MAX_PAGES=60
TENDERPROOF_MAX_OBSERVED_JSON=20
TENDERPROOF_MAX_JSON_BYTES=65536
TENDERPROOF_REPLAY_DEADLINE_S=60
TENDERPROOF_REPLAY_POLL_S=5
# Hosts documentais extras (além de novo.ibgpconcursos.com.br), separados por vírgula.
TENDERPROOF_ALLOWLIST_EXTRA=
TENDERPROOF_ARTIFACT_DIR=

# TenderProof fases 4–7. Habilitar escrita somente no ambiente autorizado.
TENDERPROOF_PUBLICATION_ENABLED=false
TENDERPROOF_PUBLICATION_ALLOW_SYNTHETIC=false
TENDERPROOF_PUBLISHER_USER_IDS=
# Chave presente não autoriza novas sessões Browser pagas.
TENDERPROOF_BROWSER_LIVE_ENABLED=false
# Processamento local sem credenciais no subprocesso; não é sandbox de segurança do SO.
TENDERPROOF_PROCESSING_CONCURRENCY=1
TENDERPROOF_PROCESSING_TOTAL_SECONDS=60
TENDERPROOF_PROCESSING_OPERATION_SECONDS=30
TENDERPROOF_PROCESSING_MAX_OUTPUT_BYTES=1000000
TENDERPROOF_PROCESSING_DIR=

# TenderProof etapas 8–10: observações contínuas para revisão, sem publicação.
# Requer também configurar cada fonte na API autenticada. Não habilita as 99.
TENDERPROOF_CONTINUOUS_ENABLED=false
TENDERPROOF_CONTINUOUS_OPERATOR_USER_IDS=
# API, worker e scheduler precisam compartilhar um diretório LOCAL persistente.
# O compose usa o volume tenderproof_data e define ARTIFACT_DIR automaticamente.
# SQLite operacional não deve ficar em NFS/SMB/OneDrive na implantação contínua.
# Fonte começa com HTTP; browser requer allow_browser, reserva de segundos e
# TENDERPROOF_BROWSER_LIVE_ENABLED. Preço faturado permanece separado da reserva.
